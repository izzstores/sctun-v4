#!/bin/bash
stty erase '^?' 2>/dev/null || stty erase '^H' 2>/dev/null || true
DF='\e[39m'
Bold='\e[1m'
Blink='\e[5m'
yell='\e[33m'
red='\e[31m'
green='\e[32m'
blue='\e[34m'
PURPLE='\e[35m'
cyan='\e[36m'
Lred='\e[91m'
Lgreen='\e[92m'
Lyellow='\e[93m'
NC='\e[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
LIGHT='\033[0;37m'
grenbo="\e[92;1m"

CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" 2>/dev/null | cut -d ' ' -f 2)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
ISP=$(curl -s ipinfo.io/org 2>/dev/null | cut -d " " -f 2-10 )
CITY=$(curl -s ipinfo.io/city 2>/dev/null )
SLOWDNS_DIR=/root/slowdns
ENV_FILE="$SLOWDNS_DIR/slowdns.env"
PUB_FILE="$SLOWDNS_DIR/server.pub"

if [ ! -r "$ENV_FILE" ]; then
    if [ -r "/etc/slowdns/slowdns.env" ]; then
        mkdir -p /root/slowdns
        cp -f /etc/slowdns/slowdns.env "$ENV_FILE"
        cp -f /etc/slowdns/server.pub "$PUB_FILE" 2>/dev/null || true
    else
        echo -e "${red}Konfigurasi SlowDNS belum ditemukan! Silakan atur di menu SlowDNS.${NC}"
        /usr/local/sbin/m-slowdns
        exit 0
    fi
fi

MAIN_DOMAIN_FILE=/etc/xray/domain
[ -r "$MAIN_DOMAIN_FILE" ] || MAIN_DOMAIN_FILE=/root/domain
domain="localhost"
[ -r "$MAIN_DOMAIN_FILE" ] && domain="$(tr -d '[:space:]' < "$MAIN_DOMAIN_FILE")"

ns_domain=$(awk -F= '$1=="SLOWDNS_DOMAIN" {gsub(/^"|"$/, "", $2); print $2; exit}' "$ENV_FILE" 2>/dev/null)
PUB=$(cat "$PUB_FILE" 2>/dev/null)

clear
echo -e "\033[1;93m┌───────────────────────────┐\033[0m"
read -e -p "   Username      : " Login
read -e -p "   Password      : " Pass
read -e -p "   Expired (Days): " masaaktif
echo -e "\033[1;93m└───────────────────────────┘\033[0m"
IP=$(curl -sS ifconfig.me 2>/dev/null || wget -qO- ipinfo.io/ip 2>/dev/null);
domen="$domain"
NS="$ns_domain"

clear
tgl=$(date -d "$masaaktif days" +"%d" 2>/dev/null)
bln=$(date -d "$masaaktif days" +"%b" 2>/dev/null)
thn=$(date -d "$masaaktif days" +"%Y" 2>/dev/null)
expe="$tgl $bln, $thn"
tgl2=$(date +"%d")
bln2=$(date +"%b")
thn2=$(date +"%Y")
tnggl="$tgl2 $bln2, $thn2"
useradd -e `date -d "$masaaktif days" +"%Y-%m-%d"` -s /bin/false -M $Login 2>/dev/null
echo -e "$Pass\n$Pass\n"|passwd $Login &> /dev/null

if [ -n "$CHATID" ] && [ -n "$KEY" ]; then
TEXT="<code>-----------------------</code>
<code>   SlowDNS Premium </code>
<code>-----------------------</code>
<code>IP Server    =</code> <code>$IP</code>
<code>Host Utama   =</code> <code>$domen</code>
<code>NS SlowDNS   =</code> <code>$NS</code>
<code>Pub Key      =</code> <code>$PUB</code>
<code>Username     =</code> <code>$Login</code>
<code>Password     =</code> <code>$Pass</code>
<code>-----------------------</code>
Aktif Selama   : $masaaktif Hari
Dibuat Pada    : $tnggl
Berakhir Pada  : $expe
<code>-----------------------</code>
"
curl -s --max-time $TIME -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" $URL >/dev/null 2>&1
fi

clear
echo -e ""
echo -e " ◇━━━━━━━━━━━━━━━━━━━━━━━━━━━━◇"
echo -e "    Your Premium VPN Details"
echo -e " ◇━━━━━━━━━━━━━━━━━━━━━━━━━━━━◇"
echo -e " IP Server        = ${IP}"
echo -e " Host Utama       = ${domen}"
echo -e " NS SlowDNS       = ${NS}"
echo -e " Pub Key          = ${PUB}"
echo -e " Username         = ${Login}"
echo -e " Password         = ${Pass}"
echo -e " ◇━━━━━━━━━━━━━━━━━━━━━━━━━━━━◇"
echo -e " Aktif Selama   : $masaaktif Hari"
echo -e " Dibuat Pada    : $tnggl"
echo -e " Berakhir Pada  : $expe"
echo -e " ◇━━━━━━━━━━━━━━━━━━━━━━━━━━━━◇"
echo ""
read -n 1 -s -r -p "Tekan Enter untuk kembali ke menu..."
